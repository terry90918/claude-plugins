{
  "private": true,
  "devDependencies": {
    "markdownlint-cli": "^0.49.1",
    "yaml": "2.9.0"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "test": "node --test scripts/*.test.mjs",
    "check:plugins": "node scripts/validate-plugin-repository.mjs",
    "check:versions": "node scripts/check-version-sync.mjs",
    "lint:md": "markdownlint 'README.md' 'CLAUDE.md' '.github/**/*.md' 'docs/ci/**/*.md' 'plugins/*/README.md' 'plugins/*/skills/*/SKILL.md' 'openspec/changes/**/*.md' 'openspec/specs/**/*.md'",
    "lint:shell": "shellcheck $(find . \\( -path ./.git -o -name node_modules -o -path './.claude/worktrees' -o -path './.spectra' -o -path './.superpowers' \\) -prune -o -name '*.sh' -print)",
    "validate:drone": "bash scripts/validate-drone-yml.sh",
    "validate:woodpecker": "node scripts/validate-woodpecker-config.mjs",
    "validate": "npm run test && npm run check:plugins && npm run check:versions && npm run lint:md && npm run lint:shell"
  }
}
